{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/release-a-seed-input-manifest-1.0.json",
  "title": "RELEASE_A_SEED_INPUT_MANIFEST",
  "description": "Immutable input binding for one high-confidence Release-A seed Product Registry assembly. Organization-only evidence is not an admissible product-row basis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "manifest_version",
    "registry_projection_version",
    "workbench_baseline_sha",
    "observatory_data_repo",
    "observatory_data_commit",
    "observatory_release_refs",
    "controlled_packet_digests",
    "evidence_index_sha256",
    "world_time_cutoff",
    "knowledge_time_cutoff",
    "jurisdiction_scope",
    "seed_input_count",
    "bindings",
    "boundary"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "pattern": "^RASIM-[0-9a-f]{64}$"
    },
    "manifest_version": {
      "const": "RELEASE_A_SEED_INPUT_MANIFEST_v1.0"
    },
    "registry_projection_version": {
      "const": "PRODUCT_REGISTRY_v1.0"
    },
    "workbench_baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observatory_data_repo": {
      "const": "fraware/neuroai-observatory-data"
    },
    "observatory_data_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observatory_release_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "controlled_packet_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "evidence_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "world_time_cutoff": {
      "type": "string",
      "format": "date"
    },
    "knowledge_time_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction_scope": {
      "type": "string",
      "minLength": 1
    },
    "seed_input_count": {
      "type": "integer",
      "minimum": 1
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry_row_id",
          "canonical_entity_id",
          "exact_product_label",
          "evidence_basis",
          "source_observation_refs",
          "projected_assertion_refs",
          "boundary_disposition_ref",
          "organization_seed_refs"
        ],
        "properties": {
          "registry_row_id": {
            "type": "string",
            "pattern": "^PRR-[0-9a-f]{64}$"
          },
          "canonical_entity_id": {
            "type": "string",
            "minLength": 1
          },
          "exact_product_label": {
            "type": "string",
            "minLength": 1
          },
          "evidence_basis": {
            "const": "EXACT_PRODUCT_OR_SERVICE_EVIDENCE"
          },
          "source_observation_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "projected_assertion_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boundary_disposition_ref": {
            "type": "string",
            "minLength": 1
          },
          "organization_seed_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
