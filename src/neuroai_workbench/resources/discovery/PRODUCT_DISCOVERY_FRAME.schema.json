{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/product-discovery-frame-1.0.json",
  "title": "PRODUCT_DISCOVERY_FRAME",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frame_id",
    "frame_version",
    "label",
    "frame_class",
    "purpose",
    "capture_estimation_eligible",
    "dependence_notes",
    "dependent_or_nested_with",
    "languages",
    "jurisdictions",
    "query_families",
    "source_classes",
    "stopping_rule",
    "status",
    "boundary"
  ],
  "properties": {
    "frame_id": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7",
        "F8",
        "F9",
        "F10",
        "F11"
      ]
    },
    "frame_version": {
      "const": "PRODUCT_DISCOVERY_FRAME_v1.0"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "frame_class": {
      "enum": [
        "FIRST_PARTY",
        "REGULATORY",
        "CLINICAL_TRIAL",
        "SCIENTIFIC_RESEARCH",
        "COMMERCIAL_ECOSYSTEM",
        "CAPABILITY_FIRST",
        "EXPERT_NOMINATION",
        "LOCAL_LANGUAGE",
        "CURATED_ACTOR_SEED",
        "PATENT_COMMERCIALIZATION",
        "SNOWBALL_EXPANSION"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capture_estimation_eligible": {
      "type": "boolean"
    },
    "dependence_notes": {
      "type": "string",
      "minLength": 1
    },
    "dependent_or_nested_with": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "F1",
          "F2",
          "F3",
          "F4",
          "F5",
          "F6",
          "F7",
          "F8",
          "F9",
          "F10",
          "F11"
        ]
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "query_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stopping_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "minimum_completed_rounds",
        "consecutive_low_yield_rounds",
        "maximum_marginal_new_identity_yield",
        "minimum_raw_candidates_per_round"
      ],
      "properties": {
        "mode": {
          "enum": [
            "MARGINAL_YIELD",
            "BOUNDED_SOURCE_EXHAUSTION",
            "MANUAL_DECLARED_LIMIT"
          ]
        },
        "minimum_completed_rounds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "consecutive_low_yield_rounds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maximum_marginal_new_identity_yield": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "minimum_raw_candidates_per_round": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "status": {
      "enum": [
        "ACTIVE",
        "RETIRED"
      ]
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
