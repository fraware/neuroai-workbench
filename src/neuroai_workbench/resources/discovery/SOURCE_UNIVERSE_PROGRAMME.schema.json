{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/source-universe-programme-1.0.json",
  "title": "SOURCE_UNIVERSE_PROGRAMME",
  "description": "Reusable source-universe discovery contract. Coverage counts are mechanical and do not establish registry completeness or recall.",
  "type": "object",
  "required": [
    "universe_id",
    "universe_version",
    "purpose",
    "inclusion",
    "exclusion",
    "authoritative_sources",
    "identity_key",
    "query_streams",
    "denominator_policy",
    "pagination_policy",
    "known_identity_reconciliation",
    "language",
    "jurisdiction",
    "cadence",
    "raw_input_boundary",
    "candidate_schema",
    "human_review_path",
    "evaluation",
    "boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "universe_id": {"type": "string", "minLength": 1},
    "universe_version": {"type": "string", "minLength": 1},
    "documentation_aliases": {"type": "array", "items": {"type": "string"}},
    "purpose": {"type": "string", "minLength": 1},
    "inclusion": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exclusion": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authoritative_sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "identity_key": {
      "type": "object",
      "required": ["name", "pattern", "match_rule"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "pattern": {"type": "string", "minLength": 1},
        "match_rule": {"type": "string", "minLength": 1}
      }
    },
    "query_streams": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "denominator_policy": {"type": "string", "minLength": 1},
    "pagination_policy": {"type": "string", "minLength": 1},
    "known_identity_reconciliation": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "cadence": {"type": "string", "minLength": 1},
    "raw_input_boundary": {"type": "string", "minLength": 1},
    "candidate_schema": {"type": "string", "minLength": 1},
    "human_review_path": {"type": "string", "minLength": 1},
    "evaluation": {"type": "object"},
    "boundary": {"type": "string", "minLength": 1}
  }
}
