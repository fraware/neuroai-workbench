{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/discovery-run-1.0.json",
  "title": "DISCOVERY_RUN",
  "description": "Record of one discovery query execution. Result counts are mechanical tallies; they do not imply registry completeness, authenticity, or substantive finding outcomes.",
  "type": "object",
  "required": [
    "run_id",
    "query_id",
    "executed_at",
    "executed_by",
    "execution_mode",
    "execution_date",
    "result_counts",
    "record_classifications",
    "proposal_ids",
    "adjudication_status",
    "automatic_registry_mutation_performed",
    "boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "pattern": "^DRUN-[0-9a-f]{32}$"},
    "query_id": {
      "type": "string",
      "pattern": "^DISCOVERY-[A-Z0-9][A-Z0-9_-]{0,96}$"
    },
    "executed_at": {"type": "string", "minLength": 10},
    "executed_by": {"type": "string", "minLength": 1},
    "execution_mode": {"enum": ["OFFLINE_FIXTURE", "OPT_IN_NETWORK"]},
    "execution_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_system": {"type": "string", "minLength": 1},
    "result_counts": {
      "type": "object",
      "required": ["total", "new", "duplicate", "excluded"],
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "new": {"type": "integer", "minimum": 0},
        "duplicate": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0}
      }
    },
    "record_classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_key", "classification", "title"],
        "additionalProperties": false,
        "properties": {
          "record_key": {"type": "string", "minLength": 1},
          "classification": {"enum": ["NEW", "DUPLICATE", "EXCLUDED"]},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": ["string", "null"]},
          "exclusion_reason": {"type": ["string", "null"]},
          "duplicate_of_source_id": {"type": ["string", "null"]}
        }
      }
    },
    "proposal_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^DSP-[0-9a-f]{32}$"}
    },
    "adjudication_status": {
      "enum": [
        "PENDING_HUMAN_REVIEW",
        "PARTIALLY_ADJUDICATED",
        "COMPLETE",
        "ABSTAINED"
      ]
    },
    "network_gate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "env_var": {"type": "string"},
        "allowed": {"type": "boolean"},
        "ssrf_policy": {"type": "string"}
      }
    },
    "automatic_registry_mutation_performed": {"const": false},
    "boundary": {"type": "string", "minLength": 1}
  }
}
