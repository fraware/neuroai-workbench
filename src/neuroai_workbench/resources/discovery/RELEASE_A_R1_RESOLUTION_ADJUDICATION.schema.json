{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RELEASE_A_R1_RESOLUTION_ADJUDICATION.schema.json",
  "title": "Release A R1 decision-relevant resolution adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adjudication_id",
    "work_item_id",
    "disposition",
    "adjudicator_state",
    "adjudicator_id",
    "evidence",
    "existing_canonical_offering_id",
    "one_object_upper_bound",
    "max_incremental_offering_contribution",
    "proposed_currentness_state",
    "proposed_lifecycle_state"
  ],
  "properties": {
    "adjudication_id": {
      "type": "string",
      "pattern": "^R1ADJ-[0-9a-f]{64}$"
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "TERMINAL_INCLUDE_EXISTING_CANONICAL",
        "TERMINAL_INCLUDE_NEW_CANONICAL_PENDING_IDENTITY_AUTHORITY",
        "TERMINAL_EXCLUDE",
        "ONE_OBJECT_UPPER_BOUND_UNRESOLVED",
        "UNRESOLVED_CARDINALITY_UNPROVEN",
        "UNBOUNDED_SOURCE_OR_ABSTENTION_BARRIER"
      ]
    },
    "adjudicator_state": {
      "enum": [
        "HUMAN_REVIEWED",
        "MACHINE_PROVISIONAL"
      ]
    },
    "adjudicator_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_ref",
          "source_locator",
          "knowledge_observed_at",
          "evidence_role",
          "supported_propositions",
          "supports_state_at_or_before_world_cutoff",
          "supported_world_time_ref",
          "sha256"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_observed_at": {
            "type": "string",
            "minLength": 1
          },
          "evidence_role": {
            "enum": [
              "DIRECT_PRE_CUTOFF_STATE",
              "RETROSPECTIVE_EXPLICIT_HISTORICAL_STATE",
              "POST_CUTOFF_CURRENT_STATE_ONLY",
              "CARDINALITY_SPECIFIC",
              "SOURCE_ENUMERATION_SPECIFIC"
            ]
          },
          "supported_propositions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "IDENTITY",
                "SCOPE",
                "CURRENTNESS",
                "LIFECYCLE",
                "CARDINALITY",
                "SOURCE_ENUMERATION"
              ]
            }
          },
          "supports_state_at_or_before_world_cutoff": {
            "type": "boolean"
          },
          "supported_world_time_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "existing_canonical_offering_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "one_object_upper_bound": {
      "type": "boolean"
    },
    "max_incremental_offering_contribution": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "proposed_currentness_state": {
      "enum": [
        "CURRENT",
        "UNRESOLVED",
        null
      ]
    },
    "proposed_lifecycle_state": {
      "enum": [
        "ANNOUNCED",
        "IN_DEVELOPMENT",
        "MANUFACTURING_PRE_DELIVERY",
        "RELEASED",
        "UNRESOLVED",
        null
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
