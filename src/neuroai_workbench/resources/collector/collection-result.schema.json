{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/collection-result-1.0.json",
  "type": "object",
  "required": [
    "result_id",
    "request_id",
    "source_id",
    "monitor_id",
    "requested_url",
    "final_url",
    "redirect_chain",
    "retrieved_at",
    "http_status",
    "media_type",
    "size_bytes",
    "sha256",
    "original_filename",
    "quarantine_path",
    "dns_resolution",
    "collector_version",
    "configuration_hash",
    "evidence_state",
    "boundary"
  ],
  "additionalProperties": false,
  "$defs": {
    "public_url": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"pattern": "^https?://[^@\\s]+$"},
        {"not": {"pattern": "//127\\."}},
        {"not": {"pattern": "//10\\."}},
        {"not": {"pattern": "//192\\.168\\."}},
        {"not": {"pattern": "//172\\.(1[6-9]|2[0-9]|3[01])\\."}},
        {"not": {"pattern": "//localhost([:/]|$)"}},
        {"not": {"pattern": "//[^/]*\\.local([:/]|$)"}},
        {"not": {"pattern": "//[^/]*\\.internal([:/]|$)"}}
      ]
    },
    "timestamp_with_timezone": {
      "type": "string",
      "minLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!.*[\\\\/])(?!\\.\\.)(?!.*\\.\\.$)[^\\x00-\\x1f]+$"
    },
    "safe_quarantine_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\./)[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    }
  },
  "properties": {
    "result_id": {"type": "string", "pattern": "^CRES-[0-9a-f]{32}$"},
    "request_id": {"type": "string", "pattern": "^CREQ-[0-9a-f]{32}$"},
    "source_id": {"type": "string", "minLength": 1},
    "monitor_id": {"type": "string", "minLength": 1},
    "requested_url": {"$ref": "#/$defs/public_url"},
    "final_url": {"$ref": "#/$defs/public_url"},
    "redirect_chain": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/public_url"}
    },
    "retrieved_at": {"$ref": "#/$defs/timestamp_with_timezone"},
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "media_type": {"type": "string", "minLength": 1},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "sha256": {"$ref": "#/$defs/sha256"},
    "original_filename": {"$ref": "#/$defs/safe_filename"},
    "quarantine_path": {"$ref": "#/$defs/safe_quarantine_path"},
    "dns_resolution": {
      "type": "object",
      "required": ["resolved_at", "addresses", "rebinding_check"],
      "additionalProperties": false,
      "properties": {
        "resolved_at": {"$ref": "#/$defs/timestamp_with_timezone"},
        "addresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1}
        },
        "rebinding_check": {"enum": ["PASSED", "BLOCKED"]}
      }
    },
    "collector_version": {"type": "string", "minLength": 1},
    "configuration_hash": {"$ref": "#/$defs/sha256"},
    "evidence_state": {"const": "RETRIEVED_BYTES_NOT_SUBSTANTIVELY_ADJUDICATED"},
    "connected_address": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "boundary": {"type": "string", "minLength": 1}
  }
}
