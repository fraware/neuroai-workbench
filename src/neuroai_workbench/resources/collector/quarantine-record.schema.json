{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/quarantine-record-1.0.json",
  "type": "object",
  "required": [
    "quarantine_id",
    "result_id",
    "source_id",
    "monitor_id",
    "captured_at",
    "sha256",
    "size_bytes",
    "original_filename",
    "quarantine_path",
    "approval_state",
    "approved_at",
    "approved_by",
    "rejection_reason",
    "collector_version",
    "configuration_hash",
    "boundary"
  ],
  "additionalProperties": false,
  "$defs": {
    "timestamp_with_timezone": {
      "type": "string",
      "minLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!.*[\\\\/])(?!\\.\\.)(?!.*\\.\\.$)[^\\x00-\\x1f]+$"
    },
    "safe_quarantine_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\./)[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    }
  },
  "properties": {
    "quarantine_id": {"type": "string", "pattern": "^QRN-[0-9a-f]{32}$"},
    "result_id": {"type": "string", "pattern": "^CRES-[0-9a-f]{32}$"},
    "source_id": {"type": "string", "minLength": 1},
    "monitor_id": {"type": "string", "minLength": 1},
    "captured_at": {"$ref": "#/$defs/timestamp_with_timezone"},
    "sha256": {"$ref": "#/$defs/sha256"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "original_filename": {"$ref": "#/$defs/safe_filename"},
    "quarantine_path": {"$ref": "#/$defs/safe_quarantine_path"},
    "approval_state": {
      "enum": ["PENDING_HUMAN_APPROVAL", "APPROVED_FOR_HANDOFF", "REJECTED"]
    },
    "approved_at": {
      "oneOf": [
        {"$ref": "#/$defs/timestamp_with_timezone"},
        {"type": "null"}
      ]
    },
    "approved_by": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "rejection_reason": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "collector_version": {"type": "string", "minLength": 1},
    "configuration_hash": {"$ref": "#/$defs/sha256"},
    "boundary": {"type": "string", "minLength": 1}
  }
}
