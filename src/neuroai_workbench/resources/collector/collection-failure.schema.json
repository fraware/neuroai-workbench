{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/collection-failure-1.0.json",
  "type": "object",
  "required": [
    "failure_id",
    "request_id",
    "source_id",
    "monitor_id",
    "requested_url",
    "failed_at",
    "failure_class",
    "failure_message",
    "retry_state",
    "collector_version",
    "configuration_hash",
    "boundary"
  ],
  "additionalProperties": false,
  "$defs": {
    "public_url": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"pattern": "^https?://[^@\\s]+$"},
        {"not": {"pattern": "//127\\."}},
        {"not": {"pattern": "//10\\."}},
        {"not": {"pattern": "//192\\.168\\."}},
        {"not": {"pattern": "//172\\.(1[6-9]|2[0-9]|3[01])\\."}},
        {"not": {"pattern": "//localhost([:/]|$)"}},
        {"not": {"pattern": "//[^/]*\\.local([:/]|$)"}},
        {"not": {"pattern": "//[^/]*\\.internal([:/]|$)"}}
      ]
    },
    "timestamp_with_timezone": {
      "type": "string",
      "minLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "properties": {
    "failure_id": {"type": "string", "pattern": "^CFAIL-[0-9a-f]{32}$"},
    "request_id": {"type": "string", "pattern": "^CREQ-[0-9a-f]{32}$"},
    "source_id": {"type": "string", "minLength": 1},
    "monitor_id": {"type": "string", "minLength": 1},
    "requested_url": {"$ref": "#/$defs/public_url"},
    "failed_at": {"$ref": "#/$defs/timestamp_with_timezone"},
    "failure_class": {
      "enum": [
        "SSRF_BLOCKED",
        "DNS_REBINDING_BLOCKED",
        "REDIRECT_BLOCKED",
        "TIMEOUT",
        "SIZE_LIMIT_EXCEEDED",
        "DECOMPRESSION_BOMB",
        "UNSAFE_FILENAME",
        "CREDENTIAL_LEAK_PREVENTED",
        "ROBOTS_DISALLOWED",
        "TERMS_OF_USE_BLOCKED",
        "HTTP_ERROR",
        "NETWORK_ERROR",
        "AUTHENTICATION_REQUIRED",
        "CONTENT_TYPE_REJECTED",
        "QUARANTINE_REJECTED",
        "UNKNOWN"
      ]
    },
    "failure_message": {"type": "string", "minLength": 1},
    "retry_state": {
      "type": "object",
      "required": ["attempt_count", "max_attempts", "next_retry_at", "exhausted"],
      "additionalProperties": false,
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "next_retry_at": {
          "oneOf": [
            {"$ref": "#/$defs/timestamp_with_timezone"},
            {"type": "null"}
          ]
        },
        "exhausted": {"type": "boolean"}
      }
    },
    "collector_version": {"type": "string", "minLength": 1},
    "configuration_hash": {"$ref": "#/$defs/sha256"},
    "boundary": {"type": "string", "minLength": 1}
  }
}
