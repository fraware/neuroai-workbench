{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/observatory-v1-6-refresh-1.0.json",
  "type": "object",
  "required": [
    "metadata",
    "baseline",
    "new_sources",
    "change_candidates",
    "adjudicated_delta",
    "reopening_decisions"
  ],
  "additionalProperties": true,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "baseline_version": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "baseline": {
      "type": "object",
      "required": ["canonical_sha256"],
      "properties": {
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "immutable": {"type": "boolean"},
        "path": {"type": "string"}
      }
    },
    "new_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "change_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_id", "adjudication", "source_ids"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "adjudication": {"type": "string", "minLength": 1},
          "source_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "adjudicated_delta": {"type": "object"},
    "reopening_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "decision"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "basis": {"type": "array", "items": {"type": "string"}},
          "object": {"type": "string"}
        }
      }
    },
    "source_checks": {"type": "array"},
    "withheld_claims": {"type": "array", "items": {"type": "string"}}
  }
}
