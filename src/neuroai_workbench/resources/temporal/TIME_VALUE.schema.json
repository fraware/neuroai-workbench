{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/time-value-1.0.json",
  "title": "TIME_VALUE",
  "description": "Precision-safe temporal value. DATE and YEAR must not be stored as fabricated timestamps.",
  "type": "object",
  "required": ["value", "precision", "boundary"],
  "additionalProperties": false,
  "properties": {
    "value": {"type": ["string", "null"]},
    "precision": {"enum": ["YEAR", "DATE", "TIMESTAMP", "UNKNOWN"]},
    "boundary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"precision": {"const": "UNKNOWN"}}},
      "then": {"properties": {"value": {"type": "null"}}}
    },
    {
      "if": {"properties": {"precision": {"const": "YEAR"}}},
      "then": {"properties": {"value": {"type": "string", "pattern": "^[0-9]{4}$"}}}
    },
    {
      "if": {"properties": {"precision": {"const": "DATE"}}},
      "then": {"properties": {"value": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}
    },
    {
      "if": {"properties": {"precision": {"const": "TIMESTAMP"}}},
      "then": {
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      }
    }
  ]
}
