{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/candidate-adjudication-1.0.json",
  "type": "object",
  "required": [
    "adjudication_id", "candidate_id", "candidate_sha256", "decided_at", "decided_by",
    "decision", "change_class", "materiality", "reopening_effect", "rationale",
    "canonical_observatory_mutation_performed", "boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "adjudication_id": {"type": "string", "pattern": "^ADJ-[0-9a-f]{32}$"},
    "candidate_id": {"type": "string", "pattern": "^CAND-[0-9a-f]{32}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decided_at": {"type": "string", "minLength": 10},
    "decided_by": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ACCEPT", "REJECT", "DEFER", "DUPLICATE", "NEEDS_EVIDENCE"]},
    "change_class": {"type": "string", "minLength": 1},
    "materiality": {"enum": ["MATERIAL", "NON_MATERIAL", "UNDETERMINED"]},
    "reopening_effect": {
      "enum": [
        "NO_EFFECT", "METADATA_UPDATE_ONLY", "EVIDENCE_GAP_UPDATE", "REVIEW_REQUIRED",
        "PARTIAL_REASSESSMENT_REQUIRED", "FULL_REASSESSMENT_REQUIRED", "UNDETERMINED"
      ]
    },
    "rationale": {"type": "string", "minLength": 1},
    "canonical_observatory_mutation_performed": {"const": false},
    "boundary": {"type": "string", "minLength": 1}
  }
}
