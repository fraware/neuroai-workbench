{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VALIDATION_CASE_MANIFEST.schema.json",
  "title": "Validation case manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "study_wave_id",
    "case_id",
    "case_class_id",
    "calibration_status",
    "normative_identity",
    "case_instructions",
    "evidence_manifest",
    "evidence_objects",
    "evidence_access_rules",
    "public_private_boundary",
    "boundary",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "manifest_id": {"type": "string", "pattern": "^VALCASE-[A-Za-z0-9._-]+$"},
    "study_wave_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_class_id": {"type": "string", "minLength": 1},
    "calibration_status": {"enum": ["HELD_OUT", "CALIBRATION_DERIVED"]},
    "normative_identity": {"$ref": "#/$defs/normative_identity"},
    "case_instructions": {"$ref": "#/$defs/reference"},
    "evidence_manifest": {"$ref": "#/$defs/reference"},
    "evidence_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "access", "reference", "sha256"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "access": {"enum": ["PUBLIC", "PROTECTED"]},
          "reference": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "evidence_access_rules": {"type": "string", "minLength": 1},
    "public_private_boundary": {"enum": ["PUBLIC_ONLY", "MIXED_WITH_PROTECTED_REFERENCES"]},
    "boundary": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "required": ["reference", "sha256"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "normative_identity": {
      "type": "object",
      "required": [
        "object_model_version",
        "kernel_requirements_sha256",
        "controlled_vocabularies_sha256",
        "assessment_schema_sha256",
        "software_commit_sha"
      ],
      "properties": {
        "object_model_version": {"const": "v4.2"},
        "kernel_requirements_sha256": {"$ref": "#/$defs/sha256"},
        "controlled_vocabularies_sha256": {"$ref": "#/$defs/sha256"},
        "assessment_schema_sha256": {"$ref": "#/$defs/sha256"},
        "software_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    }
  }
}