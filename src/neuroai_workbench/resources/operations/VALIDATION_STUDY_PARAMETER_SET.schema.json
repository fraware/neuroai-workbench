{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VALIDATION_STUDY_PARAMETER_SET.schema.json",
  "title": "Validation study parameter set",
  "type": "object",
  "required": [
    "schema_version",
    "parameter_set_id",
    "study_wave_id",
    "frozen_at",
    "outcome_access_state",
    "protocol_reference",
    "normative_identity",
    "analysis_identity",
    "case_strata",
    "cases",
    "assessor_design",
    "reliability_estimands",
    "decision_state_compatibility",
    "consequential_disagreements",
    "precision_plan",
    "stopping_rules",
    "decision_usefulness",
    "accessibility",
    "linguistic_validation",
    "missingness_and_exclusions",
    "multiplicity",
    "blinding_and_data_access",
    "amendment_policy",
    "public_protected_boundary",
    "boundary",
    "parameter_set_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "parameter_set_id": {"type": "string", "pattern": "^VALPARAM-[A-Za-z0-9._-]+$"},
    "study_wave_id": {"type": "string", "minLength": 1},
    "frozen_at": {"type": "string", "format": "date-time"},
    "outcome_access_state": {"const": "NO_OUTCOME_DATA_ACCESSED"},
    "protocol_reference": {"$ref": "#/$defs/reference"},
    "normative_identity": {"$ref": "#/$defs/normative_identity"},
    "analysis_identity": {
      "type": "object",
      "required": ["code_reference", "environment_reference", "random_seeds"],
      "properties": {
        "code_reference": {"$ref": "#/$defs/reference"},
        "environment_reference": {"$ref": "#/$defs/reference"},
        "random_seeds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "case_strata": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["stratum_id", "rationale", "inclusion_criteria", "exclusion_criteria"],
        "properties": {
          "stratum_id": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "inclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["case_id", "case_class_id", "manifest_reference", "manifest_sha256", "calibration_status"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "case_class_id": {"type": "string", "minLength": 1},
          "manifest_reference": {"type": "string", "minLength": 1},
          "manifest_sha256": {"$ref": "#/$defs/sha256"},
          "calibration_status": {"enum": ["HELD_OUT", "CALIBRATION_DERIVED"]}
        },
        "additionalProperties": false
      }
    },
    "assessor_design": {
      "type": "object",
      "required": [
        "final_assessors_per_case",
        "eligibility_criteria",
        "training_reference",
        "conflict_rules",
        "prior_familiarity_rule",
        "evidence_access_rule",
        "independent_first_pass",
        "adjudication_after_freeze"
      ],
      "properties": {
        "final_assessors_per_case": {"type": "integer", "minimum": 1},
        "precision_override_justification": {"type": "string", "minLength": 1},
        "eligibility_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "training_reference": {"$ref": "#/$defs/reference"},
        "conflict_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prior_familiarity_rule": {"type": "string", "minLength": 1},
        "evidence_access_rule": {"type": "string", "minLength": 1},
        "independent_first_pass": {"const": true},
        "adjudication_after_freeze": {"const": true}
      },
      "additionalProperties": false
    },
    "reliability_estimands": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "field_family",
          "population",
          "primary_estimate",
          "robustness_estimate",
          "distance_or_weights",
          "structural_state_handling",
          "clustering_units",
          "uncertainty_method"
        ],
        "properties": {
          "field_family": {"type": "string", "minLength": 1},
          "population": {"type": "string", "minLength": 1},
          "primary_estimate": {"type": "string", "minLength": 1},
          "robustness_estimate": {"type": "string", "minLength": 1},
          "distance_or_weights": {"type": "string", "minLength": 1},
          "structural_state_handling": {"type": "string", "minLength": 1},
          "excluded_structural_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "clustering_units": {"type": "array", "minItems": 2, "items": {"enum": ["CASE", "ASSESSOR"]}},
          "uncertainty_method": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "decision_state_compatibility": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "consequential_disagreements": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["rule_id", "field_family", "comparison_mode", "left_state", "denominator"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "field_family": {"enum": ["REQUIREMENT_FINDING", "CLAIM_STATUS", "TYPED_DECISION"]},
          "decision_object_type": {"type": "string", "minLength": 1},
          "comparison_mode": {"enum": ["STATE_PAIR", "PRESENCE_ABSENCE"]},
          "left_state": {"type": "string", "minLength": 1},
          "right_state": {"type": "string", "minLength": 1},
          "denominator": {"type": "string", "minLength": 1},
          "interval_method": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "precision_plan": {
      "type": "object",
      "required": [
        "method",
        "planning_assumptions",
        "target_precision",
        "clustering_model",
        "simulation_code_reference",
        "case_counts_by_stratum",
        "assessor_allocation",
        "disagreement_prevalence_sensitivity"
      ],
      "properties": {
        "method": {"enum": ["SIMULATION", "ANALYTIC", "HYBRID"]},
        "planning_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "target_precision": {"type": "string", "minLength": 1},
        "clustering_model": {"type": "string", "minLength": 1},
        "simulation_code_reference": {"$ref": "#/$defs/reference"},
        "case_counts_by_stratum": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["stratum_id", "case_count"],
            "properties": {
              "stratum_id": {"type": "string", "minLength": 1},
              "case_count": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "assessor_allocation": {"type": "string", "minLength": 1},
        "disagreement_prevalence_sensitivity": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}
      },
      "additionalProperties": false
    },
    "stopping_rules": {
      "type": "object",
      "required": ["recruitment_target", "outcome_adaptive_stopping", "interim_outcome_access", "under_recruitment_rule"],
      "properties": {
        "recruitment_target": {"type": "string", "minLength": 1},
        "outcome_adaptive_stopping": {"const": false},
        "interim_outcome_access": {"const": false},
        "under_recruitment_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decision_usefulness": {
      "type": "object",
      "required": [
        "comparator_reference",
        "primary_outcome_definition",
        "critical_defect_taxonomy",
        "assignment_strategy",
        "counterbalancing",
        "period_learning_controls",
        "outcome_adjudicator_blinding"
      ],
      "properties": {
        "comparator_reference": {"$ref": "#/$defs/reference"},
        "primary_outcome_definition": {"type": "string", "minLength": 1},
        "critical_defect_taxonomy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assignment_strategy": {"type": "string", "minLength": 1},
        "counterbalancing": {"type": "string", "minLength": 1},
        "period_learning_controls": {"type": "string", "minLength": 1},
        "outcome_adjudicator_blinding": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": ["representative_user_strata", "assistive_technology_matrix", "critical_tasks", "primary_outcomes"],
      "properties": {
        "representative_user_strata": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assistive_technology_matrix": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "critical_tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["task_id", "definition", "critical_failure_definition"],
            "properties": {
              "task_id": {"type": "string", "minLength": 1},
              "definition": {"type": "string", "minLength": 1},
              "critical_failure_definition": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "primary_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "linguistic_validation": {
      "type": "object",
      "required": ["proposed_non_english_publication_locales", "locale_parameters"],
      "properties": {
        "proposed_non_english_publication_locales": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "locale_parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["locale", "terminology_review", "comprehension_test", "decision_critical_terms"],
            "properties": {
              "locale": {"type": "string", "minLength": 2},
              "terminology_review": {"type": "string", "minLength": 1},
              "comprehension_test": {"type": "string", "minLength": 1},
              "decision_critical_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "missingness_and_exclusions": {
      "type": "object",
      "required": ["structural_states_are_observed", "missingness_rule", "exclusion_rules", "post_outcome_exclusion_rule"],
      "properties": {
        "structural_states_are_observed": {"const": true},
        "missingness_rule": {"type": "string", "minLength": 1},
        "exclusion_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "post_outcome_exclusion_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "multiplicity": {"type": "string", "minLength": 1},
    "blinding_and_data_access": {
      "type": "object",
      "required": ["independent_assessor_blinding_rule", "adjudicator_blinding_rule", "amendment_outcome_access_recorded"],
      "properties": {
        "independent_assessor_blinding_rule": {"type": "string", "minLength": 1},
        "adjudicator_blinding_rule": {"type": "string", "minLength": 1},
        "amendment_outcome_access_recorded": {"const": true}
      },
      "additionalProperties": false
    },
    "amendment_policy": {"type": "string", "minLength": 1},
    "public_protected_boundary": {"type": "string", "minLength": 1},
    "boundary": {"type": "string", "minLength": 1},
    "parameter_set_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "required": ["reference", "sha256"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "normative_identity": {
      "type": "object",
      "required": [
        "object_model_version",
        "kernel_requirements_sha256",
        "controlled_vocabularies_sha256",
        "assessment_schema_sha256",
        "software_commit_sha"
      ],
      "properties": {
        "object_model_version": {"const": "v4.2"},
        "kernel_requirements_sha256": {"$ref": "#/$defs/sha256"},
        "controlled_vocabularies_sha256": {"$ref": "#/$defs/sha256"},
        "assessment_schema_sha256": {"$ref": "#/$defs/sha256"},
        "software_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    }
  }
}