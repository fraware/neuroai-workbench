{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/change-candidate-1.0.json",
  "type": "object",
  "required": [
    "candidate_id", "created_at", "created_by", "source_id", "source_snapshot_ids",
    "current_snapshot_sha256", "detection", "summary", "proposed_change_class",
    "proposed_materiality", "proposed_reopening_effect", "extracted_claims", "status",
    "automatic_mutation_performed", "boundary"
  ],
  "additionalProperties": false,
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^CAND-[0-9a-f]{32}$"},
    "created_at": {"type": "string", "minLength": 10},
    "created_by": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_snapshot_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
    "current_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "detection": {"type": "object"},
    "summary": {"type": "string", "minLength": 1},
    "proposed_change_class": {"const": "UNCLASSIFIED"},
    "proposed_materiality": {"const": "UNDETERMINED"},
    "proposed_reopening_effect": {"const": "UNDETERMINED"},
    "extracted_claims": {"type": "array"},
    "status": {"const": "PENDING_HUMAN_ADJUDICATION"},
    "automatic_mutation_performed": {"const": false},
    "boundary": {"type": "string", "minLength": 1}
  }
}
