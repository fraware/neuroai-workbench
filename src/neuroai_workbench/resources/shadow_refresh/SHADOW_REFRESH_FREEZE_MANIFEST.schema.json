{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/shadow-refresh-freeze-manifest-1.0.json",
  "type": "object",
  "required": ["metadata", "configuration_hashes", "cohort_reference", "withheld_claims", "boundary"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "run_id", "frozen_at", "status", "evidence_cutoff"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "frozen_at": {"type": "string", "minLength": 10},
        "status": {"const": "SHADOW_EVALUATION_NOT_CANONICAL"},
        "evidence_cutoff": {"type": "string", "minLength": 10},
        "frozen_by": {"type": "string", "minLength": 1}
      }
    },
    "configuration_hashes": {
      "type": "object",
      "required": [
        "registry_sha256",
        "monitoring_policy_sha256",
        "reopening_policy_sha256",
        "collector_sha256",
        "workbench_sha256",
        "entity_resolution_sha256",
        "extraction_sha256",
        "reviewer_roster_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "monitoring_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reopening_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "collector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workbench_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entity_resolution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extraction_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer_roster_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cohort_reference": {
      "type": "object",
      "required": ["cohort_id", "sha256", "source_count"],
      "additionalProperties": false,
      "properties": {
        "cohort_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_count": {"type": "integer", "minimum": 1}
      }
    },
    "withheld_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "boundary": {"type": "string", "minLength": 1}
  }
}
