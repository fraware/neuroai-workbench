{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/shadow-refresh-cohort-1.0.json",
  "type": "object",
  "required": ["metadata", "sources"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "cohort_id", "version", "status", "source_count", "boundary"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "cohort_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "SHADOW_EVALUATION_NOT_CANONICAL"},
        "source_count": {"type": "integer", "minimum": 1},
        "boundary": {"type": "string", "minLength": 1},
        "parent_epic_issue": {"type": "string"},
        "evaluation_issue": {"type": "string"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "monitor_id",
          "url",
          "publisher",
          "source_class",
          "cohort_category",
          "jurisdiction",
          "cadence",
          "baseline_claim_boundary"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "monitor_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "source_class": {"type": "string", "minLength": 1},
          "cohort_category": {
            "enum": [
              "PRIMA_SCIENCE",
              "SYNCHRON",
              "PARADROMICS",
              "BRAIN2QWERTY",
              "FDA_ADBS",
              "BRAINGATE2_T15",
              "REGISTRY",
              "OWNERSHIP_FUNDING",
              "SAFETY",
              "SUPPLIER_DEPENDENCY"
            ]
          },
          "jurisdiction": {"type": "string", "minLength": 1},
          "cadence": {"enum": ["DAILY", "WEEKLY", "MONTHLY", "QUARTERLY", "ANNUAL", "MANUAL"]},
          "baseline_claim_boundary": {"type": "string", "minLength": 1},
          "related_system": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "withheld_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
