{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/release-a-estimation-universe-1.0.json",
  "title": "RELEASE_A_ESTIMATION_UNIVERSE",
  "description": "Preregistered identity and model universe for one Release-A unseen-product population estimate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "universe_id",
    "preregistration_version",
    "role",
    "boundary_contract_id",
    "boundary_contract_semantic_blob",
    "reference_standard_id",
    "reference_standard_version",
    "reference_standard_validation_state",
    "registry_projection_version",
    "population_view_policy_id",
    "currentness_policy_id",
    "population_view_id",
    "identity_level",
    "included_enumeration_roles",
    "analysis_jurisdiction_scope",
    "world_time_cutoff",
    "knowledge_time_cutoff",
    "language_scope_id",
    "frame_register_version",
    "capture_frame_ids",
    "frame_set_policy_id",
    "holdback_policy_id",
    "reporting_policy_id",
    "observed_identity_unit",
    "latent_residual_unit",
    "model_families",
    "naive_pairwise_role",
    "required_diagnostics",
    "required_sensitivities",
    "boundary"
  ],
  "properties": {
    "universe_id": {
      "type": "string",
      "pattern": "^RAEU-[0-9a-f]{64}$"
    },
    "preregistration_version": {
      "const": "RELEASE_A_ANALYSIS_PREREGISTRATION_v1.0"
    },
    "role": {
      "enum": [
        "PRIMARY",
        "SECONDARY"
      ]
    },
    "boundary_contract_id": {
      "const": "PRODUCT_MEASUREMENT_CONTRACT_v1.0"
    },
    "boundary_contract_semantic_blob": {
      "const": "7cbd7f086d80505da7a7c35a38f3aa0ce690ec41"
    },
    "reference_standard_id": {
      "const": "D4_PRODUCT_REFERENCE_STANDARD_v1.0"
    },
    "reference_standard_version": {
      "const": "1.0"
    },
    "reference_standard_validation_state": {
      "const": "FROZEN_WORKING_REFERENCE"
    },
    "registry_projection_version": {
      "const": "PRODUCT_REGISTRY_v1.0"
    },
    "population_view_policy_id": {
      "const": "PRODUCT_POPULATION_VIEW_POLICY_v1.0"
    },
    "currentness_policy_id": {
      "const": "PRODUCT_CURRENTNESS_POLICY_v1.0"
    },
    "population_view_id": {
      "enum": [
        "A-P1",
        "A-P4",
        "A-P6"
      ]
    },
    "identity_level": {
      "const": "OFFERING"
    },
    "included_enumeration_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "INTEGRATED_SYSTEM",
          "COMPONENT_OR_SUBSYSTEM",
          "STANDALONE_SOFTWARE_OR_SERVICE"
        ]
      }
    },
    "analysis_jurisdiction_scope": {
      "type": "string",
      "minLength": 1
    },
    "world_time_cutoff": {
      "type": "string",
      "format": "date"
    },
    "knowledge_time_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "language_scope_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_register_version": {
      "const": "PRODUCT_DISCOVERY_FRAME_REGISTER_v1.0"
    },
    "capture_frame_ids": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "F1",
          "F2",
          "F3",
          "F4",
          "F5",
          "F6",
          "F7",
          "F8",
          "F9",
          "F10",
          "F11"
        ]
      }
    },
    "frame_set_policy_id": {
      "const": "RELEASE_A_FRAME_SET_POLICY_v1.0"
    },
    "holdback_policy_id": {
      "const": "RELEASE_A_LATE_ROUND_HOLDBACK_v1.0"
    },
    "reporting_policy_id": {
      "const": "RELEASE_A_MODEL_ENVELOPE_REPORTING_v1.0"
    },
    "observed_identity_unit": {
      "const": "CANONICAL_PRODUCT_OFFERING"
    },
    "latent_residual_unit": {
      "const": "UNOBSERVED_DISTINCT_PRODUCT_OFFERINGS"
    },
    "model_families": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OBSERVED_ONLY_BASELINE",
          "PAIRWISE_CAPTURE_RECAPTURE_DIAGNOSTIC",
          "LOG_LINEAR_INDEPENDENCE_BASELINE",
          "LOG_LINEAR_DEPENDENCE_INTERACTIONS",
          "STRATIFIED_DEPENDENCE_MODEL",
          "BAYESIAN_HIERARCHICAL_SENSITIVITY"
        ]
      }
    },
    "naive_pairwise_role": {
      "const": "DIAGNOSTIC_ONLY"
    },
    "required_diagnostics": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FRAME_DEPENDENCE",
          "SOURCE_CLASS_DEPENDENCE",
          "CAPTURE_HETEROGENEITY",
          "SPARSE_OVERLAP_CELLS",
          "IDENTIFIABILITY_STABILITY",
          "FRAME_SET_SENSITIVITY",
          "BOUNDARY_IDENTITY_SENSITIVITY",
          "ZERO_CAPTURE_RISK",
          "LATE_ROUND_PREDICTIVE_CHECK",
          "MODEL_SPREAD",
          "KNOWN_EXTERNAL_ONLY_IDENTITIES"
        ]
      }
    },
    "required_sensitivities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "UNRESOLVED_IDENTITY",
          "BORDERLINE_ABSTAIN",
          "CURRENTNESS_UNCERTAINTY",
          "MULTILINGUAL_GAIN",
          "ENUMERATION_ROLE",
          "FRAME_SET"
        ]
      }
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
