{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroai-workbench.example/schemas/release-a-a2-execution-manifest-1.0.json",
  "title": "RELEASE_A_A2_EXECUTION_MANIFEST",
  "description": "Frozen A2 execution binding over the existing P0.5 estimation-universe contract, A1 seed basis, collection window, and multilingual design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "execution_manifest_id",
    "status",
    "workbench_baseline_sha",
    "a1_seed_manifest_id",
    "a1_seed_registry_sha256",
    "a1_evidence_index_sha256",
    "estimation_universe",
    "collection_window",
    "language_design",
    "diagnostic_only_frame_ids",
    "initial_known_offering_ids",
    "initial_known_offering_count",
    "initial_known_identity_set_sha256",
    "round_start_known_identity_policy",
    "post_world_cutoff_observation_policy",
    "boundary"
  ],
  "properties": {
    "manifest_version": {
      "const": "RELEASE_A_A2_EXECUTION_MANIFEST_v1.0"
    },
    "execution_manifest_id": {
      "type": "string",
      "pattern": "^A2X-[0-9a-f]{64}$"
    },
    "status": {
      "const": "FROZEN_v1.0"
    },
    "workbench_baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "a1_seed_manifest_id": {
      "type": "string",
      "pattern": "^RASIM-[0-9a-f]{64}$"
    },
    "a1_seed_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "a1_evidence_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "estimation_universe": {
      "type": "object"
    },
    "collection_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opened_at",
        "closes_at"
      ],
      "properties": {
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "closes_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "language_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language_scope_id",
        "baseline_language",
        "native_language_strata",
        "selection_basis",
        "f8_execution_policy"
      ],
      "properties": {
        "language_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_language": {
          "type": "string",
          "minLength": 1
        },
        "native_language_strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "jurisdiction"
            ],
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1
              },
              "jurisdiction": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "selection_basis": {
          "type": "string",
          "minLength": 1
        },
        "f8_execution_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnostic_only_frame_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "F7",
          "F9",
          "F11"
        ]
      }
    },
    "initial_known_offering_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "initial_known_offering_count": {
      "type": "integer",
      "minimum": 1
    },
    "initial_known_identity_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "round_start_known_identity_policy": {
      "type": "string",
      "minLength": 1
    },
    "post_world_cutoff_observation_policy": {
      "type": "string",
      "minLength": 1
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
